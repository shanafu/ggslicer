\dontrun{
geom <- SliceGeometry$new(
  origin = c(0, 0, 0), direction_i = c(1, 0, 0), direction_j = c(0, 1, 0),
  spacing = c(1, 1), size = c(10, 10)
)
bounds <- geom$get_bounds()
