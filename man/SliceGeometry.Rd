    The \code{SliceGeometry} object, invisibly (for chaining).
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-SliceGeometry-set_extent"></a>}}
\if{latex}{\out{\hypertarget{method-SliceGeometry-set_extent}{}}}
\subsection{\code{SliceGeometry$set_extent()}}{
  Set the physical extent (width, height) directly, deriving
either \code{spacing} (keeping \code{size} fixed) or \code{size} (keeping \code{spacing}
fixed) to match.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{SliceGeometry$set_extent(extent, adjust = c("spacing", "size"))}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{extent}}{Numeric length-2 vector, both entries \verb{>= 0}.}
      \item{\code{adjust}}{Which field to derive: \code{"spacing"} (default, changes
resolution to fit the new extent at the current sample count) or
\code{"size"} (changes sample count to fit the new extent at the current
resolution).}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The \code{SliceGeometry} object, invisibly (for chaining).
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-SliceGeometry-translate"></a>}}
\if{latex}{\out{\hypertarget{method-SliceGeometry-translate}{}}}
\subsection{\code{SliceGeometry$translate()}}{
  Return a new \code{SliceGeometry}, identical to this one but with its
origin shifted by \code{offset} (e.g. \code{offset = spacing_k * get_normal()}
to move to the next parallel slice in a stack).
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{SliceGeometry$translate(offset)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{offset}}{Numeric length-3 vector.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A new \code{SliceGeometry} object.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-SliceGeometry-as_sitk_reference_image"></a>}}
\if{latex}{\out{\hypertarget{method-SliceGeometry-as_sitk_reference_image}{}}}
\subsection{\code{SliceGeometry$as_sitk_reference_image()}}{
  Build a pixel-less, single-voxel-thick SimpleITK
reference image whose geometry (origin/direction/spacing/size)
exactly matches this slice, suitable as the \code{referenceImage}
argument to \code{SimpleITK::Resample()} for extracting intensities.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{SliceGeometry$as_sitk_reference_image(spacing_k = 1)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{spacing_k}}{Spacing to assign to the synthetic third (normal) axis. Arbitrary, since that axis has only one sample; defaults to \code{1}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A \code{SimpleITK} image object of size \verb{(n_i, n_j, 1)}, with no
pixel data set (all zeros).
  }
}

