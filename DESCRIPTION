Package: ggslicer
Title: Prepare Volumetric Imaging Data
Version: 0.0.0.9000
Authors@R: c(
    person("Shana", "Fu", email = "shana.fu@ucalgary.ca", role = c("aut", "cre")))
Description: Functions that allow for efficient wrangling of imaging data into 
    a data frame. An image file is provided, along with the desired image axis
    and specific voxel coordinates to extract voxel and world coordinates, and 
    intensity data at each coordinate.
Imports:
    dplyr,
    ggplot2,
    grDevices,
    magrittr,
    pbapply,
    R6,
    rlang,
    SimpleITK,
    tibble,
    tidyselect,
    tools
